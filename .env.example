# SQLite is ready to use with no external service.
DATABASE_URL=sqlite:///./vehicle_analytics.db

# Use the local MP4 by default. For a MediaMTX stream, set this to rtsp://127.0.0.1:8554/traffic
VIDEO_SOURCE=traffic.mp4
VIDEO_LOOP=true
STREAM_NAME=traffic-camera-01

# Ultralytics COCO detector. The weights download automatically on first run.
VEHICLE_MODEL=yolo11n.pt
CONFIDENCE_THRESHOLD=0.35
INFERENCE_WIDTH=640
INFERENCE_STRIDE=1

# Horizontal count line as a fraction of frame height (0.0 to 1.0).
COUNT_LINE_POSITION=0.55

# Set to 0 to disable annotation output.
SAVE_ANNOTATED_VIDEO=1
ANNOTATED_VIDEO_PATH=runs/annotated.mp4

HOST=127.0.0.1
PORT=8000
